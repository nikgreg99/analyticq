{
  "dev": {
    "app_name": "AnalyticQ-Backend",
    "debug": true,
    "host": "127.0.0.1",
    "port": 5000,
    "workers": 1,
    "codebase": {
      "default_branch": "main",
      "retention": 5,
      "file_filter": {
        "extensions_excluded": [
          ".exe", ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff",
          ".mp4", ".mov", ".avi", ".mkv", ".mp3", ".wav", ".flac",
          ".pdf", ".zip", ".tar", ".gz", ".rar", ".7z", ".iso", ".bak",
          ".swp", ".swo", ".log", ".sqlite", ".db", ".dat", ".out", ".dmp",
          ".class", ".jar", ".dll", ".so", ".o", ".a", ".obj", ".pyc", ".pyo",
          ".pdb", ".dylib"
        ],
        "filenames_excluded": [
          "LICENSE", "README.md", ".gitignore", ".dockerignore", "Dockerfile",
          "Makefile", "package.json", "requirements.txt", "npm-debug.log",
          "yarn-error.log", "composer.json", "composer.lock", "Cargo.toml",
          "Pipfile", "Pipfile.lock", "tsconfig.json", "webpack.config.js",
          ".travis.yml", ".circleci", "*.log", ".npmrc", ".env"
        ],
        "max_file_size": 52428800
      },
      "dir_filter": {
        "excluded_dirs": [".git", ".github", ".gitlab", ".vscode", ".idea",
          "node_modules", "vendor", "target", "build", "dist", "tmp", "*.vs",
          ".tox", ".eggs", ".env", ".cache", ".pytest_cache", "*.bundle",
          ".d", ".cache", ".nvm"],
        "max_depth": 100
      }
    }
  },
  "prod": {
